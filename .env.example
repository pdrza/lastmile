# ============================================================
# Variáveis de ambiente do pacote Last Mile.
#
# Copie este arquivo para um arquivo chamado  .env  (mesmo diretório)
# e preencha os valores. O .env NÃO vai para o repositório (tem segredos).
# ============================================================

# Senha do banco de dados PostgreSQL. Escolha qualquer senha forte.
DB_PASSWORD=troque-esta-senha

# Segredo usado para assinar os tokens de login (JWT).
# Use no mínimo 32 caracteres aleatórios.
JWT_SECRET=gere-uma-chave-aleatoria-de-no-minimo-32-caracteres

# Chave da API OpenRouteService — usada para converter endereços em
# coordenadas e calcular a rota otimizada.
# Crie uma chave gratuita em: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=cole-sua-chave-openrouteservice-aqui
